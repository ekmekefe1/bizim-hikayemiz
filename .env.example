# Cloudinary Configuration
# Sign up at https://cloudinary.com and get your credentials from the Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flask
SECRET_KEY=
FLASK_DEBUG=0

# Database (optional — defaults to SQLite)
DATABASE_URL=

# Upload folder (optional — defaults to static/uploads/)
# Not used when Cloudinary is configured. Local fallback only.
UPLOAD_FOLDER=
